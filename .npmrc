auto-install-peers=true
strict-peer-dependencies=false

# Render sets NODE_ENV=production on the service, and pnpm reads that as "install
# dependencies only" — which strips vite, tsc, tsx and migrate-mongo, the four things the
# build and the pre-deploy command actually run. This restores the default without
# depending on the host's build command carrying `--prod=false`. An explicit
# `pnpm install --prod` still prunes, so a deliberate slim install is unaffected.
production=false

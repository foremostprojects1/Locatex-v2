# Copy to `.env` (or .env.development / .env.production) and fill in.
# Only values prefixed with VITE_ are exposed to the browser — never put
# server-side secrets here.

# Google Maps JavaScript API key used by the listing and contact maps.
# Without it the map areas render a notice instead of a map.
VITE_GOOGLE_MAPS_API_KEY=

# Origin that serves the PHP mail handlers of the original template
# (contact/contact-process.php, mail/subscribe.php, mail/subscribe-mailchimp.php).
# Leave empty to post to the same origin as the app.
VITE_API_BASE_URL=

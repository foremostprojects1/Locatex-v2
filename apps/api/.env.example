NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=locatex
REDIS_URL=redis://127.0.0.1:6379

# 32+ characters. Rotate on suspicion; bumping it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-32+
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# COOKIE_DOMAIN=.locatex.in

# --- single deployment ------------------------------------------------------
# When true the API also serves apps/web/dist, so the whole product is one process.
# Leave false in development: Vite serves the app and proxies /api to this server.
SERVE_WEB=false
# Optional override; defaults to ../../web/dist relative to the compiled API.
WEB_DIST_PATH=

# Namespace for BullMQ keys — keeps environments sharing one Redis apart.
QUEUE_PREFIX=locatex

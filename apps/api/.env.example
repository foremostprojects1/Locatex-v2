NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=locatexv2
REDIS_URL=redis://127.0.0.1:6379

# 32+ characters. Rotate on suspicion; bumping it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-32+
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# COOKIE_DOMAIN=.locatex.in

# --- single deployment ------------------------------------------------------
# When true the API also serves apps/web/dist, so the whole product is one process.
# Leave false in development: Vite serves the app and proxies /api to this server.
SERVE_WEB=false
# Optional override; defaults to ../../web/dist relative to the compiled API.
WEB_DIST_PATH=

# Namespace for BullMQ keys — keeps environments sharing one Redis apart.
QUEUE_PREFIX=locatex

# ---------------------------------------------------------------------------
# Outgoing mail — Gmail with an app password (decision D6)
# ---------------------------------------------------------------------------
# Turn on two-factor authentication on the Google account, then create an app
# password at https://myaccount.google.com/apppasswords and paste it below.
# It is sixteen characters; the account's real password never goes here, and
# revoking this one costs nothing.
#
# Leave SMTP_HOST empty and the system logs what it would have sent instead of
# sending it — which is how development and the test suite run.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=sixteen-char-app-password

# The address messages appear to come from. To send as info@locatex.in rather
# than the Gmail address, add it under Gmail → Settings → Accounts → "Send mail
# as", verify it, and put it here. Gmail rewrites the From header to the Gmail
# account unless the alias has been verified this way.
MAIL_FROM=info@locatex.in
MAIL_FROM_NAME=LocateX
MAIL_REPLY_TO=info@locatex.in

# A free Google account is locked — not throttled — at roughly 500 messages a
# day. We stop short of that ourselves and warn well before.
EMAIL_DAILY_LIMIT=450
EMAIL_DAILY_WARN_AT=350

# ---------------------------------------------------------------------------
# Document storage — Google Drive (decision D1)
# ---------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com (type: Web
# application), add the redirect URI below to it, and enable the Drive API.
# Scope needed: https://www.googleapis.com/auth/drive.file — that is the
# narrow one, giving access only to files this app created, not to the whole
# Drive. Ask for anything wider and Google's verification review applies.
#
# Leave GOOGLE_CLIENT_ID empty and documents are kept in memory: uploads work
# in development and every one is lost on restart, which is what you want
# locally and never in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the stored refresh token. Any passphrase of 16+ characters; changing
# it makes the stored token unreadable and the Drive must be reconnected.
STORAGE_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Cloudinary — listing photographs
# ---------------------------------------------------------------------------
# Images and documents go to different places on purpose. Drive has no
# transformations and throttles downloads, so a listing page pulling ten photos
# from it would be slow for buyers and would burn the 15 GB account.
#
# Uploads are signed by this server and go straight from the browser. Leave
# these empty and brokers paste image links instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
